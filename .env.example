# =============================================================================
# Bot editorial Telegram — variables de entorno
# Copia este archivo:  cp .env.example .env
# =============================================================================

# --- Obligatorio para resúmenes con Claude ---
# Obtener en: https://console.anthropic.com/ → API Keys
ANTHROPIC_API_KEY=

# --- Obligatorio para el bot Telegram ---
# 1. Habla con @BotFather → /newbot → copia el token
TELEGRAM_BOT_TOKEN=

# 2. Envía un mensaje a tu bot, luego ejecuta:
#    python3 scripts/get_telegram_chat_id.py
TELEGRAM_CHAT_ID=

# --- Opcional ---
DATABASE_PATH=./data/editorial.db
MIN_RELEVANCE_SCORE=3
MAX_ARTICLES_PER_INFORME=30
MAX_DESTACADOS=8
MAX_RELEVANTES=12
MAX_SECUNDARIOS=10
MAX_REPORT_WORDS=2500
TIMEZONE=Europe/Madrid

# --- Agente de priorización editorial (post-clasificación) ---
# Pesos de los tres ejes (no tienen que sumar 1; la puntuación total es la suma ponderada)
PRIORITIZE_WEIGHT_REPETITION=0.35
PRIORITIZE_WEIGHT_RECENCY=0.30
PRIORITIZE_WEIGHT_TIER=0.35
# Repetición: techo de fuentes distintas que normaliza el eje (máx. 1.0)
PRIORITIZE_REPETITION_CAP=10
# Clustering semántico: umbral de similitud coseno (0-1) para agrupar en el mismo evento
PRIORITIZE_SIMILARITY_THRESHOLD=0.72
# Umbral más estricto para artículos del mismo medio (evita fusionar reseñas distintas)
PRIORITIZE_SAME_MEDIO_SIMILARITY_THRESHOLD=0.88
# Umbral extra para listas genéricas cross-media ("best books of 2026", etc.)
PRIORITIZE_GENERIC_SIMILARITY_THRESHOLD=0.88
# Tamaño máximo de un evento agrupado
PRIORITIZE_MAX_CLUSTER_SIZE=8
# Máximo de artículos a embedir por informe (rendimiento Telegram)
PRIORITIZE_MAX_BATCH=120
# Umbral mínimo de puntuación total para incluir un evento en el informe
PRIORITIZE_SCORE_THRESHOLD=0.45
# Actualidad: horas para puntuación plena / parcial / antigua
PRIORITIZE_RECENCY_HOURS_FULL=24
PRIORITIZE_RECENCY_HOURS_PARTIAL=48
PRIORITIZE_RECENCY_PARTIAL_SCORE=0.55
PRIORITIZE_RECENCY_OLD_SCORE=0.15
PRIORITIZE_RECENCY_UNKNOWN_SCORE=0.40
# Tier: puntuaciones del eje según presencia de Tier 1 o repetición en Tier 2
PRIORITIZE_TIER1_SCORE=1.0
PRIORITIZE_TIER2_HIGH_REP_SCORE=0.60
PRIORITIZE_TIER2_LOW_REP_SCORE=0.35
PRIORITIZE_TIER2_REP_THRESHOLD=4
# Modelo de embeddings multilingüe (fastembed)
PRIORITIZE_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
PRIORITIZE_EMBEDDING_PREFIX=
