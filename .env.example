# =============================================================================
# Bot editorial Telegram — variables de entorno
# Copia este archivo:  cp .env.example .env
# =============================================================================

# --- Obligatorio para resúmenes con Claude ---
# Obtener en: https://console.anthropic.com/ → API Keys
ANTHROPIC_API_KEY=

# --- Obligatorio para el bot Telegram ---
# 1. Habla con @BotFather → /newbot → copia el token
TELEGRAM_BOT_TOKEN=

# 2. Envía un mensaje a tu bot, luego ejecuta:
#    python3 scripts/get_telegram_chat_id.py
TELEGRAM_CHAT_ID=

# --- Opcional ---
DATABASE_PATH=./data/editorial.db
MIN_RELEVANCE_SCORE=3
MAX_ARTICLES_PER_INFORME=30
MAX_DESTACADOS=8
MAX_RELEVANTES=12
MAX_SECUNDARIOS=10
TIMEZONE=Europe/Madrid
